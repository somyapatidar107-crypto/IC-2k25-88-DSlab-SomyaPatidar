
#include <iostream>
using namespace std;

const int MAX = 10;

void inputMatrix(int a[MAX][MAX], int r, int c) {
    cout << "Enter matrix elements:\n";

    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            if (!(cin >> a[i][j])) {
                cout << "Invalid matrix element!\n";
                exit(1);
            }
        }
    }
}

void displayMatrix(int a[MAX][MAX], int r, int c) {
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++)
            cout << a[i][j] << "\t";
        cout << endl;
    }
}

void addition(int a[MAX][MAX], int b[MAX][MAX],
              int r, int c) {
    int result[MAX][MAX];

    for (int i = 0; i < r; i++)
        for (int j = 0; j < c; j++)
            result[i][j] = a[i][j] + b[i][j];

    cout << "\nResult of Addition:\n";
    displayMatrix(result, r, c);
}

void subtraction(int a[MAX][MAX], int b[MAX][MAX],
                 int r, int c) {
    int result[MAX][MAX];

    for (int i = 0; i < r; i++)
        for (int j = 0; j < c; j++)
            result[i][j] = a[i][j] - b[i][j];

    cout << "\nResult of Subtraction:\n";
    displayMatrix(result, r, c);
}

void multiplication(int a[MAX][MAX], int b[MAX][MAX],
                    int r1, int c1, int c2) {
    int result[MAX][MAX] = {};

    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            for (int k = 0; k < c1; k++) {
                result[i][j] += a[i][k] * b[k][j];
            }
        }
    }

    cout << "\nResult of Multiplication:\n";
    displayMatrix(result, r1, c2);
}

void transpose(int a[MAX][MAX], int r, int c) {
    int result[MAX][MAX];

    for (int i = 0; i < r; i++)
        for (int j = 0; j < c; j++)
            result[j][i] = a[i][j];

    cout << "\nTranspose of Matrix:\n";
    displayMatrix(result, c, r);
}

int main() {
    int a[MAX][MAX], b[MAX][MAX];
    int r1, c1, r2, c2, choice;

    cout << "===== MATRIX CALCULATOR =====\n";

    cout << "Enter rows and columns of Matrix A: ";
    cin >> r1 >> c1;

    if (!cin || r1 < 1 || r1 > MAX ||
        c1 < 1 || c1 > MAX) {
        cout << "Invalid dimensions!\n";
        return 1;
    }

    inputMatrix(a, r1, c1);

    cout << "Enter rows and columns of Matrix B: ";
    cin >> r2 >> c2;

    if (!cin || r2 < 1 || r2 > MAX ||
        c2 < 1 || c2 > MAX) {
        cout << "Invalid dimensions!\n";
        return 1;
    }

    inputMatrix(b, r2, c2);

    do {
        cout << "\n===== MATRIX CALCULATOR MENU =====\n";
        cout << "1. Addition\n";
        cout << "2. Subtraction\n";
        cout << "3. Multiplication\n";
        cout << "4. Transpose of Matrix A\n";
        cout << "5. Transpose of Matrix B\n";
        cout << "6. Display Matrices\n";
        cout << "7. Exit\n";

        cout << "Enter your choice: ";
        cin >> choice;

        if (!cin) {
            cout << "Invalid choice input!\n";
            return 1;
        }

        switch (choice) {
            case 1:
                if (r1 == r2 && c1 == c2)
                    addition(a, b, r1, c1);
                else
                    cout << "Matrices must have same dimensions!\n";
                break;

            case 2:
                if (r1 == r2 && c1 == c2)
                    subtraction(a, b, r1, c1);
                else
                    cout << "Matrices must have same dimensions!\n";
                break;

            case 3:
                if (c1 == r2)
                    multiplication(a, b, r1, c1, c2);
                else
                    cout << "Columns of A must equal rows of B!\n";
                break;

            case 4:
                transpose(a, r1, c1);
                break;

            case 5:
                transpose(b, r2, c2);
                break;

            case 6:
                cout << "\nMatrix A:\n";
                displayMatrix(a, r1, c1);

                cout << "\nMatrix B:\n";
                displayMatrix(b, r2, c2);
                break;

            case 7:
                cout << "Thank you for using Matrix Calculator!\n";
                break;

            default:
                cout << "Invalid choice! Try again.\n";
        }

    } while (choice != 7);

    return 0;
}
