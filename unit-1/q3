
#include <iostream>
using namespace std;

const int MAX = 20;

void displayMatrix(int a[MAX][MAX], int r, int c) {
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++)
            cout << a[i][j] << "\t";
        cout << endl;
    }
}

void createTriplet(int a[MAX][MAX], int r, int c,
                   int triplet[MAX * MAX + 1][3]) {
    int k = 1;

    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            if (a[i][j] != 0) {
                triplet[k][0] = i;
                triplet[k][1] = j;
                triplet[k][2] = a[i][j];
                k++;
            }
        }
    }

    triplet[0][0] = r;
    triplet[0][1] = c;
    triplet[0][2] = k - 1;
}

void displayTriplet(int triplet[MAX * MAX + 1][3]) {
    int count = triplet[0][2];

    cout << "\nTriplet Representation:\n";
    cout << "Row\tColumn\tValue\n";

    for (int i = 0; i <= count; i++) {
        cout << triplet[i][0] << "\t"
             << triplet[i][1] << "\t"
             << triplet[i][2] << endl;
    }
}

void transposeTriplet(int triplet[MAX * MAX + 1][3],
                      int trans[MAX * MAX + 1][3]) {
    int count = triplet[0][2];

    trans[0][0] = triplet[0][1];
    trans[0][1] = triplet[0][0];
    trans[0][2] = count;

    int k = 1;

    // Visit columns in ascending order.
    for (int col = 0; col < triplet[0][1]; col++) {
        for (int i = 1; i <= count; i++) {
            if (triplet[i][1] == col) {
                trans[k][0] = triplet[i][1];
                trans[k][1] = triplet[i][0];
                trans[k][2] = triplet[i][2];
                k++;
            }
        }
    }
}

int main() {
    int a[MAX][MAX];
    int triplet[MAX * MAX + 1][3];
    int trans[MAX * MAX + 1][3];
    int r, c;

    cout << "Enter rows and columns (maximum 20): ";
    cin >> r >> c;

    if (!cin || r < 1 || r > MAX || c < 1 || c > MAX) {
        cout << "Invalid matrix dimensions!\n";
        return 1;
    }

    cout << "Enter matrix elements:\n";

    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            if (!(cin >> a[i][j])) {
                cout << "Invalid input!\n";
                return 1;
            }
        }
    }

    cout << "\nOriginal Matrix:\n";
    displayMatrix(a, r, c);

    createTriplet(a, r, c, triplet);

    displayTriplet(triplet);

    transposeTriplet(triplet, trans);

    cout << "\nTranspose in Triplet Representation:\n";
    displayTriplet(trans);

    cout << "\nNumber of non-zero elements: "
         << triplet[0][2] << endl;

    return 0;
}
