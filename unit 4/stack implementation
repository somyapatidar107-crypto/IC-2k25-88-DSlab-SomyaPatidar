
#include <iostream>
using namespace std;

// Static Stack using Array
class StaticStack {
    int arr[100];
    int top;

public:
    StaticStack() { top = -1; }

    void push(int x) {
        if (top == 99)
            cout << "Stack Overflow\n";
        else {
            arr[++top] = x;
            cout << "Element pushed.\n";
        }
    }

    void pop() {
        if (top == -1)
            cout << "Stack Underflow\n";
        else
            cout << "Popped: " << arr[top--] << endl;
    }

    void display() {
        if (top == -1) {
            cout << "Stack is empty.\n";
            return;
        }
        for (int i = top; i >= 0; i--)
            cout << arr[i] << endl;
    }
};

// Dynamic Stack using Linked List
struct Node {
    int data;
    Node* next;
};

class DynamicStack {
    Node* top;

public:
    DynamicStack() { top = NULL; }

    void push(int x) {
        Node* n = new Node{x, top};
        top = n;
        cout << "Element pushed.\n";
    }

    void pop() {
        if (top == NULL) {
            cout << "Stack Underflow\n";
            return;
        }

        Node* temp = top;
        cout << "Popped: " << temp->data << endl;
        top = top->next;
        delete temp;
    }

    void display() {
        Node* temp = top;
        if (temp == NULL) {
            cout << "Stack is empty.\n";
            return;
        }

        while (temp != NULL) {
            cout << temp->data << endl;
            temp = temp->next;
        }
    }
};

int main() {
    StaticStack s;
    DynamicStack d;
    int type, choice, value;

    cout << "1. Static Stack\n2. Dynamic Stack\nChoose: ";
    cin >> type;

    do {
        cout << "\n1. Push\n2. Pop\n3. Display\n0. Exit\nChoice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "Enter value: ";
                cin >> value;
                if (type == 1) s.push(value);
                else if (type == 2) d.push(value);
                break;

            case 2:
                if (type == 1) s.pop();
                else if (type == 2) d.pop();
                break;

            case 3:
                if (type == 1) s.display();
                else if (type == 2) d.display();
                break;
        }
    } while (choice != 0);

    return 0;
}
