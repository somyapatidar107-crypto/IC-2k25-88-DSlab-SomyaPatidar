
#include <iostream>
using namespace std;

const int MAX = 10;

void inputMatrix(int a[MAX][MAX], int r, int c) {
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            cout << "Enter element [" << i << "][" << j << "]: ";
            cin >> a[i][j];
        }
    }
}

void displayMatrix(int a[MAX][MAX], int r, int c) {
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++)
            cout << a[i][j] << "\t";
        cout << endl;
    }
}

void addMatrix(int a[MAX][MAX], int b[MAX][MAX],
               int r, int c) {
    int result[MAX][MAX];

    for (int i = 0; i < r; i++)
        for (int j = 0; j < c; j++)
            result[i][j] = a[i][j] + b[i][j];

    cout << "\nAddition:\n";
    displayMatrix(result, r, c);
}

void subtractMatrix(int a[MAX][MAX], int b[MAX][MAX],
                    int r, int c) {
    int result[MAX][MAX];

    for (int i = 0; i < r; i++)
        for (int j = 0; j < c; j++)
            result[i][j] = a[i][j] - b[i][j];

    cout << "\nSubtraction:\n";
    displayMatrix(result, r, c);
}

void multiplyMatrix(int a[MAX][MAX], int b[MAX][MAX],
                    int r1, int c1, int c2) {
    int result[MAX][MAX] = {};

    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            for (int k = 0; k < c1; k++)
                result[i][j] += a[i][k] * b[k][j];
        }
    }

    cout << "\nMultiplication:\n";
    displayMatrix(result, r1, c2);
}

void transposeMatrix(int a[MAX][MAX], int r, int c) {
    int result[MAX][MAX];

    for (int i = 0; i < r; i++)
        for (int j = 0; j < c; j++)
            result[j][i] = a[i][j];

    cout << "\nTranspose:\n";
    displayMatrix(result, c, r);
}

int main() {
    int a[MAX][MAX], b[MAX][MAX];
    int r1, c1, r2, c2, choice;

    cout << "Enter rows and columns of Matrix A: ";
    cin >> r1 >> c1;

    if (!cin || r1 < 1 || r1 > MAX || c1 < 1 || c1 > MAX) {
        cout << "Invalid matrix dimensions!\n";
        return 1;
    }

    cout << "Enter Matrix A:\n";
    inputMatrix(a, r1, c1);

    cout << "\nEnter rows and columns of Matrix B: ";
    cin >> r2 >> c2;

    if (!cin || r2 < 1 || r2 > MAX || c2 < 1 || c2 > MAX) {
        cout << "Invalid matrix dimensions!\n";
        return 1;
    }

    cout << "Enter Matrix B:\n";
    inputMatrix(b, r2, c2);

    do {
        cout << "\n--- 2D ARRAY OPERATIONS ---\n";
        cout << "1. Display matrices\n";
        cout << "2. Addition\n";
        cout << "3. Subtraction\n";
        cout << "4. Multiplication\n";
        cout << "5. Transpose of Matrix A\n";
        cout << "6. Transpose of Matrix B\n";
        cout << "7. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        if (!cin) {
            cout << "Invalid input!\n";
            return 1;
        }

        switch (choice) {
            case 1:
                cout << "Matrix A:\n";
                displayMatrix(a, r1, c1);
                cout << "Matrix B:\n";
                displayMatrix(b, r2, c2);
                break;

            case 2:
                if (r1 == r2 && c1 == c2)
                    addMatrix(a, b, r1, c1);
                else
                    cout << "Addition not possible!\n";
                break;

            case 3:
                if (r1 == r2 && c1 == c2)
                    subtractMatrix(a, b, r1, c1);
                else
                    cout << "Subtraction not possible!\n";
                break;

            case 4:
                if (c1 == r2)
                    multiplyMatrix(a, b, r1, c1, c2);
                else
                    cout << "Multiplication not possible!\n";
                break;

            case 5:
                transposeMatrix(a, r1, c1);
                break;

            case 6:
                transposeMatrix(b, r2, c2);
                break;

            case 7:
                cout << "Exiting program.\n";
                break;

            default:
                cout << "Invalid choice!\n";
        }

    } while (choice != 7);

    return 0;
}
