
#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

// Binary Search
int binarySearch(vector<int>& a, int key) {
    int low = 0;
    int high = a.size() - 1;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (a[mid] == key)
            return mid;

        else if (a[mid] < key)
            low = mid + 1;

        else
            high = mid - 1;
    }

    return -1;
}

// Main Function
int main() {
    int n, key;

    cout << "Enter number of elements: ";
    cin >> n;

    if (n <= 0) {
        cout << "Invalid size.\n";
        return 0;
    }

    vector<int> a(n);

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++)
        cin >> a[i];

    sort(a.begin(), a.end());

    cout << "Sorted array: ";
    for (int x : a)
        cout << x << " ";

    cout << "\nEnter element to search: ";
    cin >> key;

    int result = binarySearch(a, key);

    if (result != -1)
        cout << "Element found at index " << result << endl;
    else
        cout << "Element not found." << endl;

    return 0;
}
