
#include <iostream>
#include <vector>
#include <queue>
#include <stack>
using namespace std;

void bfs(vector<vector<int>>& adj, int start) {
    vector<bool> visited(adj.size(), false);
    queue<int> q;

    visited[start] = true;
    q.push(start);

    cout << "BFS: ";

    while (!q.empty()) {
        int v = q.front();
        q.pop();

        cout << v << " ";

        for (int next : adj[v]) {
            if (!visited[next]) {
                visited[next] = true;
                q.push(next);
            }
        }
    }
    cout << endl;
}

void dfsRecursive(vector<vector<int>>& adj,
                  vector<bool>& visited, int v) {
    visited[v] = true;
    cout << v << " ";

    for (int next : adj[v]) {
        if (!visited[next])
            dfsRecursive(adj, visited, next);
    }
}

void dfsIterative(vector<vector<int>>& adj, int start) {
    vector<bool> visited(adj.size(), false);
    stack<int> st;

    st.push(start);
    cout << "Iterative DFS: ";

    while (!st.empty()) {
        int v = st.top();
        st.pop();

        if (visited[v]) continue;

        visited[v] = true;
        cout << v << " ";

        for (int i = (int)adj[v].size() - 1; i >= 0; i--) {
            if (!visited[adj[v][i]])
                st.push(adj[v][i]);
        }
    }
    cout << endl;
}

int main() {
    int n, e, u, v, start;

    cout << "Enter vertices and edges: ";
    cin >> n >> e;

    vector<vector<int>> adj(n);

    cout << "Enter edges:\n";
    for (int i = 0; i < e; i++) {
        cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    cout << "Enter starting vertex: ";
    cin >> start;

    if (start < 0 || start >= n) {
        cout << "Invalid starting vertex.\n";
        return 0;
    }

    bfs(adj, start);

    vector<bool> visited(n, false);
    cout << "Recursive DFS: ";
    dfsRecursive(adj, visited, start);
    cout << endl;

    dfsIterative(adj, start);

    return 0;
}
