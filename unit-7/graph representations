
#include <iostream>
#include <vector>
using namespace std;

int main() {
    int vertices, edges;

    cout << "Enter number of vertices and edges: ";
    cin >> vertices >> edges;

    vector<vector<int>> matrix(vertices,
                               vector<int>(vertices, 0));

    vector<vector<int>> adj(vertices);

    cout << "Enter edges (u v), using vertices from 0: \n";

    for (int i = 0; i < edges; i++) {
        int u, v;
        cin >> u >> v;

        if (u < 0 || u >= vertices || v < 0 || v >= vertices) {
            cout << "Invalid edge. Try again.\n";
            i--;
            continue;
        }

        matrix[u][v] = 1;
        matrix[v][u] = 1;

        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    cout << "\nAdjacency Matrix:\n";

    for (int i = 0; i < vertices; i++) {
        for (int j = 0; j < vertices; j++)
            cout << matrix[i][j] << " ";
        cout << endl;
    }

    cout << "\nAdjacency List:\n";

    for (int i = 0; i < vertices; i++) {
        cout << i << " -> ";

        for (int v : adj[i])
            cout << v << " ";

        cout << endl;
    }

    return 0;
}
