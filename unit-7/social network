
#include <iostream>
#include <vector>
#include <string>
using namespace std;

int main() {
    int n, choice;
    cout << "Enter number of people: ";
    cin >> n;

    vector<string> names(n);
    vector<vector<int>> adj(n, vector<int>(n, 0));

    for (int i = 0; i < n; i++) {
        cout << "Enter name of person " << i << ": ";
        cin >> names[i];
    }

    do {
        cout << "\n1. Add Friendship";
        cout << "\n2. Display Friends";
        cout << "\n3. Find Friends of Friends";
        cout << "\n0. Exit";
        cout << "\nChoice: ";
        cin >> choice;

        if (choice == 1) {
            int a, b;
            cout << "Enter two person numbers: ";
            cin >> a >> b;

            if (a >= 0 && a < n && b >= 0 && b < n && a != b) {
                adj[a][b] = adj[b][a] = 1;
                cout << "Friendship added.\n";
            } else {
                cout << "Invalid people.\n";
            }
        }

        else if (choice == 2 || choice == 3) {
            int person;
            cout << "Enter person number: ";
            cin >> person;

            if (person < 0 || person >= n) {
                cout << "Invalid person.\n";
                continue;
            }

            if (choice == 2) {
                cout << "Friends of " << names[person] << ":\n";

                for (int i = 0; i < n; i++)
                    if (adj[person][i])
                        cout << names[i] << endl;
            } else {
                cout << "Friends of friends:\n";
                bool found = false;

                for (int i = 0; i < n; i++) {
                    if (adj[person][i]) {
                        for (int j = 0; j < n; j++) {
                            if (adj[i][j] && j != person &&
                                !adj[person][j]) {
                                cout << names[j] << endl;
                                found = true;
                            }
                        }
                    }
                }

                if (!found)
                    cout << "No friends of friends found.\n";
            }
        }
    } while (choice != 0);

    return 0;
}
