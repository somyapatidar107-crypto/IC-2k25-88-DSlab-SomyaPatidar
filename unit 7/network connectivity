
#include <iostream>
#include <vector>
using namespace std;

void dfs(int vertex, vector<vector<int>>& adj,
         vector<bool>& visited) {
    visited[vertex] = true;

    for (int next : adj[vertex]) {
        if (!visited[next])
            dfs(next, adj, visited);
    }
}

int main() {
    int n, e;

    cout << "Enter number of network devices and connections: ";
    cin >> n >> e;

    vector<vector<int>> adj(n);

    cout << "Enter connections (u v):\n";

    for (int i = 0; i < e; i++) {
        int u, v;
        cin >> u >> v;

        if (u < 0 || u >= n || v < 0 || v >= n) {
            cout << "Invalid connection.\n";
            i--;
            continue;
        }

        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    if (n == 0) {
        cout << "Network has no devices.\n";
        return 0;
    }

    vector<bool> visited(n, false);
    int components = 0;

    for (int i = 0; i < n; i++) {
        if (!visited[i]) {
            components++;
            dfs(i, adj, visited);
        }
    }

    cout << "Number of connected components: "
         << components << endl;

    if (components == 1)
        cout << "The network is fully connected.\n";
    else
        cout << "The network is not fully connected.\n";

    return 0;
}
